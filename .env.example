# MADU Platform Environment Variables
# نسخ هذا الملف إلى .env وتعبئة القيم المطلوبة

# ======================
# Server Configuration
# ======================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ======================
# Frontend Configuration
# ======================
FRONTEND_URL=http://localhost:3000

# ======================
# Database Configuration
# ======================
MONGODB_URI=mongodb://localhost:27017/madu-platform
DB_NAME=madu-platform

# ======================
# Redis Configuration
# ======================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ======================
# JWT Configuration
# ======================
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# Encryption
# ======================
ENCRYPTION_KEY=your-256-bit-encryption-key-here

# ======================
# Blockchain Configuration
# ======================
# عناوين العقود الذكية (يتم ملؤها بعد النشر)
MADU_TOKEN_CONTRACT=
MADU_STAKING_CONTRACT=

# عقد RPC للبلوك تشين
RPC_URL_TUNISIA=https://madu-tn.madu-platform.org
RPC_URL_LIBYA=https://madu-ly.madu-platform.org
RPC_URL_ALGERIA=https://madu-dz.madu-platform.org
TESTNET_RPC_URL=http://testnet.madu-platform.org:8545

# مفاتيح خاصة للعمليات الإدارية
ADMIN_PRIVATE_KEY=your-admin-private-key-here

# ======================
# Email Configuration
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ======================
# File Upload
# ======================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ======================
# External APIs
# ======================
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
NOTIFICATION_SERVICE_URL=https://notifications.madu-platform.org

# ======================
# KYC/AML Services
# ======================
KYC_API_URL=https://kyc-provider.com/api
KYC_API_KEY=your-kyc-api-key
AML_SCREENING_URL=https://aml-provider.com/api

# ======================
# Central Banks APIs
# ======================
# البنك المركزي التونسي
BCT_API_URL=https://api.bct.gov.tn
BCT_API_KEY=your-bct-api-key

# مصرف ليبيا المركزي
CBL_API_URL=https://api.cbl.gov.ly
CBL_API_KEY=your-cbl-api-key

# بنك الجزائر
BOA_API_URL=https://api.bank-of-algeria.dz
BOA_API_KEY=your-boa-api-key

# ======================
# Security Configuration
# ======================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
SESSION_SECRET=your-session-secret-here

# ======================
# Monitoring & Logging
# ======================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn-here

# ======================
# Testing Configuration
# ======================
TEST_MONGODB_URI=mongodb://localhost:27017/madu-test
TEST_REDIS_URL=redis://localhost:6379/1

# ======================
# Truffle Configuration
# ======================
# للنشر على الشبكات
TESTNET_MNEMONIC=your-testnet-mnemonic-here
MAINNET_MNEMONIC=your-mainnet-mnemonic-here

# ======================
# Additional Services
# ======================
# خدمات إضافية حسب الحاجة
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-phone

# Firebase للإشعارات المحمولة
FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# AWS S3 لتخزين الملفات
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=madu-platform-files

# Google Analytics
GOOGLE_ANALYTICS_ID=your-ga-tracking-id

# Stripe للمدفوعات (إذا لزم الأمر)
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key