{
  "name": "@madu/blockchain",
  "version": "1.0.0",
  "description": "MADU Blockchain Core - النواة الأساسية لبلوك تشين الدينار المغاربي",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "setup": "npm install && npm run build",
    "deploy": "npm run build && node dist/deploy.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "elliptic": "^6.5.4",
    "merkletreejs": "^0.3.11",
    "sha256": "^0.2.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "redis": "^4.6.10",
    "mongoose": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "validator": "^13.11.0",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/validator": "^13.11.7",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  },
  "keywords": [
    "blockchain",
    "cryptocurrency",
    "proof-of-stake",
    "consensus",
    "distributed-ledger"
  ]
}