{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tax.gov/schemas/invoice.schema.json",
  "title": "CTC UBL-Aligned Invoice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoiceId",
    "issueDate",
    "seller",
    "buyer",
    "items",
    "totals",
    "signatures"
  ],
  "properties": {
    "invoiceId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "default": "1.0" },
    "issueDate": { "type": "string", "format": "date-time" },
    "invoiceType": { "type": "string", "enum": ["STANDARD", "CREDIT", "DEBIT"] },
    "seller": {
      "type": "object",
      "required": ["tin", "name"],
      "properties": {
        "tin": { "type": "string", "pattern": "^[0-9A-Za-z\-]{5,20}$" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "branchId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "buyer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "tin": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "buyerType": { "type": "string", "enum": ["B2B", "B2C"] }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unitPrice"],
        "properties": {
          "sku": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unitPrice": { "type": "number", "minimum": 0 },
          "discount": { "type": "number", "minimum": 0, "default": 0 },
          "taxRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "taxAmount": { "type": "number", "minimum": 0 },
          "lineTotal": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "required": ["grandTotal", "currency"],
      "properties": {
        "subtotal": { "type": "number", "minimum": 0 },
        "taxTotal": { "type": "number", "minimum": 0 },
        "grandTotal": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "additionalProperties": false
    },
    "payment": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "reference": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ctc": {
      "type": "object",
      "properties": {
        "clearanceMode": { "type": "string", "enum": ["CLEARANCE", "REPORTING"] },
        "qr": { "type": "string" },
        "hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string", "enum": ["JWS", "JAdES"] },
          "alg": { "type": "string" },
          "kid": { "type": "string" },
          "value": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mimeType": { "type": "string" },
          "contentBase64": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
